{
  "name": "@avs/editorial-swiss",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 check",
    "still": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 snapshot --at",
    "render": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 render --output out/editorial-swiss.mp4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "gsap": "3.14.2"
  }
}

{
  "name": "@avs/broadcast-news",
  "private": true,
  "type": "module",
  "scripts": {
    "tts": "node scripts/tts-script.mjs && python ../../skill/scripts/tts.py assets/audio/script.json --out-dir assets/audio",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 check",
    "still": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 snapshot --at 1,5,13,21,28",
    "render": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 render --output out/broadcast-news.mp4"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "gsap": "3.14.2"
  }
}

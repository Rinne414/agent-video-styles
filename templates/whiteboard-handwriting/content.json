  "hook": {
    "speech": "Why does a hundred dollars snowball over time?",
    "lines": ["Why does $100 snowball?"],
    "underlineWord": "snowball",
    "accent": "red"
  },
  "blocks": [
    {
      "id": "year1",
      "speech": "Put a hundred dollars in the bank at ten percent a year. After one year, you have one hundred ten.",
      "label": "Year 1",
      "accent": "blue",
      "from": "$100",
      "to": "$110",
      "rate": "+10%",
      "gain": "+$10"
    },
    {
      "id": "year2",
      "speech": "In year two, you earn ten percent on one hundred ten. That extra dollar is interest on interest.",
      "label": "Year 2",
      "accent": "red",
      "from": "$110",
      "to": "$121",
      "rate": "+10%",
      "note": "interest on interest!"
    },
    {
      "id": "snowball",
      "speech": "Like a snowball rolling downhill, it picks up more snow with every turn, so it grows faster and faster.",
      "label": "Snowball",
      "accent": "blue",
      "note": "bigger = faster"
    },
    {
      "id": "early",
      "speech": "So start early. Forty years of growth beats thirty by more than two and a half times.",
      "label": "Start early",
      "accent": "green",
      "ratio": "2.6x",
      "rows": [
        { "years": "40 yrs", "value": "$4,526", "share": 1 },
        { "years": "30 yrs", "value": "$1,745", "share": 0.386 }
      ]
    }
  ],
  "end": {
    "speech": "Start early, and let time do the work.",
    "lines": ["Start early!"],
    "accent": "green"
  }

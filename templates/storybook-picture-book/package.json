{
  "name": "@avs/storybook-picture-book",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 check",
    "still": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 snapshot --at 2.5,6,10.5,14.2,19,23.5,28.5,34.3,38.5",
    "render": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 render --output out/storybook-picture-book.mp4",
    "tts": "node scripts/make-tts-script.mjs && python ../../skill/scripts/tts.py assets/audio/script.json --out-dir assets/audio"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "gsap": "3.14.2"
  }
}

{
  "name": "@avs/character-dialogue",
  "version": "1.0.0",
  "private": true,
  "description": "Two code-drawn mascots explain what an API is over a blackboard, with lip-flap, expressions and captions.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render CharacterDialogue out/character-dialogue.mp4",
    "still": "remotion still CharacterDialogue out/still.png --image-format=png --frame=300",
    "audio": "python scripts/build_audio.py"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/media": "4.0.534",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534",
    "typescript": "7.0.2"
  }
}

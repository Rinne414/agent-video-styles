  "steps": [
    "1 / 3   Install the package",
    "2 / 3   Write the limiter",
    "3 / 3   Apply it to the app",
    "Run it"
  ],
  "install": {
    "cwd": "~/api",
    "command": "npm install express express-rate-limit",
    "output": [

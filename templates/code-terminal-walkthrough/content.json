  "file": {
    "name": "server.js",
    "lang": "javascript",
    "lines": [
      {
        "text": "const express = require('express');"
      },
      {
        "text": "const { rateLimit } = require('express-rate-limit');",
        "group": "A"
      },
      {
        "text": ""
      },
      {
        "text": "const app = express();"
      },
      {
        "text": ""
      },
      {
        "text": "const limiter = rateLimit({",
        "group": "B"
      },
      {
        "text": "  windowMs: 15 * 60 * 1000,",
        "group": "B",
        "callout": "15-minute window"
      },
      {
        "text": "  limit: 100,",
        "group": "B",
        "callout": "100 requests per window"
      },
      {
        "text": "  standardHeaders: 'draft-8',",
        "group": "B"
      },
      {
        "text": "  legacyHeaders: false,",
        "group": "B"
      },
      {
        "text": "});",
        "group": "B"
      },
      {
        "text": "",
        "group": "B"
      },
      {
        "text": "app.use(limiter);",
        "group": "C",
        "callout": "Applies to every route"
      },
      {
        "text": "",
        "group": "C"
      },
      {
        "text": "app.get('/api/ping', (req, res) => res.json({ ok: true }));"
      },
      {
        "text": "app.listen(8080);"
      }
    ]
  },
  "run": {

    },
    {
      "from": 265,
      "to": 345,
      "text": "A cache sits in front of the database"
    },
    {
      "from": 345,
      "to": 440,
      "text": "Wires link every tier"
    },
    {
      "from": 440,
      "to": 504,
      "text": "The request hits the balancer"
    },
    {
      "from": 504,
      "to": 580,
      "text": "One server takes it"
    },
    {
      "from": 580,
      "to": 644,
      "text": "Cache miss: ask the database"
    },
    {
      "from": 644,
      "to": 736,
      "text": "The answer travels back"

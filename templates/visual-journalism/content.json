  "narration": [
    {
      "id": "s1",
      "speech": "Before 1956, moving cargo across an ocean was slow, manual work."
    },
    {
      "id": "s2",
      "speech": "Goods went aboard piece by piece, and ships sat in port for days."
    },
    {
      "id": "s3",
      "speech": "On April 26, 1956, the Ideal X sailed from Newark with 58 metal containers."
    },
    {
      "id": "s4",
      "speech": "Standard sizes followed: twenty or forty feet, stackable on any ship, train, or truck."
    },
    {
      "id": "s5",
      "speech": "Loading cost fell from about six dollars a ton to sixteen cents."
    },
    {
      "id": "s6",
      "speech": "Economists find containers lifted trade more than trade agreements did."
    },
    {
      "id": "s7",
      "speech": "One steel box made the world smaller."
    }
  ],

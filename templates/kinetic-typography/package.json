{
  "name": "@avs/kinetic-typography",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 check",
    "still": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 snapshot",
    "dev": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 preview",
    "render": "node scripts/build.mjs && npx --yes hyperframes@0.8.143 render --output out/kinetic-typography.mp4"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0"
  }
}
